#!/data/data/com.termux/files/usr/bin/bash
# codemux — pemasang & pemelihara Termux (M4: install + launcher + ingatan).
# shellcheck shell=bash
set -Eeuo pipefail

CODEMUX_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$CODEMUX_ROOT/lib/common.sh"
codemux_colors
# shellcheck source=../lib/state.sh
. "$CODEMUX_ROOT/lib/state.sh"
# shellcheck source=../lib/exec.sh
. "$CODEMUX_ROOT/lib/exec.sh"
# shellcheck source=../lib/adapter.sh
. "$CODEMUX_ROOT/lib/adapter.sh"
# shellcheck source=../lib/check.sh
. "$CODEMUX_ROOT/lib/check.sh"
# shellcheck source=../lib/install.sh
. "$CODEMUX_ROOT/lib/install.sh"
# shellcheck source=../lib/repair.sh
. "$CODEMUX_ROOT/lib/repair.sh"
# shellcheck source=../lib/memory.sh
. "$CODEMUX_ROOT/lib/memory.sh"
# shellcheck source=../lib/update.sh
. "$CODEMUX_ROOT/lib/update.sh"
# shellcheck source=../lib/maintenance.sh
. "$CODEMUX_ROOT/lib/maintenance.sh"

cmd="${1:-help}"
if [ "$#" -gt 0 ]; then shift; fi

case "$cmd" in
  check) codemux_cmd_check "$@" ;;
  install) codemux_cmd_install "$@" ;;
  status) codemux_cmd_status "$@" ;;
  repair) codemux_cmd_repair "$@" ;;
  memory) codemux_cmd_memory "$@" ;;
  update-check) codemux_cmd_update_check "$@" ;;
  doctor) codemux_cmd_doctor "$@" ;;
  upgrade) codemux_cmd_upgrade "$@" ;;
  uninstall) codemux_cmd_uninstall "$@" ;;
  version | --version | -V) codemux_versions ;;
  help | --help | -h) codemux_usage ;;
  self-update)
    codemux_not_ready "$cmd"
    ;;
  *)
    log_fail "perintah tidak dikenal: $cmd"
    codemux_usage >&2
    exit 1
    ;;
esac
