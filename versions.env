# versions.env — pinned versions & package lists.
# Used by: lib/modules/*.sh, tests/, CI.
# Format: KEY="value" (no spaces around '=').

# --- components managed by codemux ------------------------------------------
OPENCODE_V1_VERSION="1.19.5"
OPENCODE_V2_VERSION="2.2.5"

# Upstream repos (adapter; not a code copy)
UPSTREAM_CODEMUX="kusnuzon/codemux"
UPSTREAM_V1="kusnuzon/opencode-termux"
UPSTREAM_V2="kusnuzon/opencode-termux-v2"

# --- apt packages considered "required toolset" -----------------------------
# dpkg package names, not binary names.
# Required: on failure -> toolset module FAILS. Installed once up front so a
# fresh Termux is complete right away (git, python, gh, jq, node, etc.).
CODEMUX_APT_PACKAGES="git curl wget tar unzip gzip coreutils ca-certificates nano less openssh jq python gh sqlite shellcheck ncdu htop yq nodejs"

# Extra repo for optional packages (chromium/tesseract live in x11-repo).
CODEMUX_APT_REPOS="x11-repo"

# Optional: large / needs an extra repo. Failure -> WARN only.
CODEMUX_APT_EXTRA="tesseract chromium"

# Optional groups (can be skipped with --skip)
CODEMUX_GROUP_BROWSER="chromium"
CODEMUX_GROUP_PYTHON="python numpy pyyaml greenlet"

# apt mirror used when sources.list is empty/broken.
CODEMUX_MIRROR_MAIN="https://mirror.jeonnam.school/termux/termux-main"
