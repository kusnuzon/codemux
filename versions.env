# versions.env — versi yang dipin & daftar paket.
# Dipakai oleh: lib/modules/*.sh, tests/, CI.
# Format: KEY="nilai" (tanpa spasi di sekitar '=').

# --- komponen yang dikelola codemux -----------------------------------------
OPENCODE_V1_VERSION="1.19.3"
OPENCODE_V2_VERSION="2.1.2"

# Repo hulu (adapter; bukan salinan kode)
UPSTREAM_CODEMUX="kusnuzon/codemux"
UPSTREAM_V1="kusnuzon/opencode-termux"
UPSTREAM_V2="kusnuzon/opencode-termux-v2"

# --- paket apt yang dianggap "toolset wajib" --------------------------------
# Nama paket dpkg, bukan nama binary.
CODEMUX_APT_PACKAGES="git curl wget tar unzip gzip coreutils nano less openssh gh sqlite shellcheck ncdu htop yq python nodejs tesseract chromium"

# Grup opsional (bisa dilewati dengan --skip)
CODEMUX_GROUP_BROWSER="chromium"
CODEMUX_GROUP_PYTHON="python numpy pyyaml greenlet"
