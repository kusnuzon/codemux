# versions.env — versi yang dipin & daftar paket.
# Dipakai oleh: lib/modules/*.sh, tests/, CI.
# Format: KEY="nilai" (tanpa spasi di sekitar '=').

# --- komponen yang dikelola codemux -----------------------------------------
OPENCODE_V1_VERSION="1.19.5"
OPENCODE_V2_VERSION="2.2.5"

# Repo hulu (adapter; bukan salinan kode)
UPSTREAM_CODEMUX="kusnuzon/codemux"
UPSTREAM_V1="kusnuzon/opencode-termux"
UPSTREAM_V2="kusnuzon/opencode-termux-v2"

# --- paket apt yang dianggap "toolset wajib" --------------------------------
# Nama paket dpkg, bukan nama binary.
# Wajib: kalau gagal -> modul toolset FAIL. Dipasang satu kali di awal supaya
# Termux baru langsung lengkap (git, python, gh, jq, node, dll).
CODEMUX_APT_PACKAGES="git curl wget tar unzip gzip coreutils ca-certificates nano less openssh jq python gh sqlite shellcheck ncdu htop yq nodejs"

# Repo tambahan untuk paket opsional (chromium/tesseract ada di x11-repo).
CODEMUX_APT_REPOS="x11-repo"

# Opsional: besar / butuh repo tambahan. Gagal -> hanya WARN.
CODEMUX_APT_EXTRA="tesseract chromium"

# Grup opsional (bisa dilewati dengan --skip)
CODEMUX_GROUP_BROWSER="chromium"
CODEMUX_GROUP_PYTHON="python numpy pyyaml greenlet"

# Mirror apt yang dipakai kalau sources.list kosong/rusak.
CODEMUX_MIRROR_MAIN="https://mirror.jeonnam.school/termux/termux-main"
